#!/bin/sh
set -e
cd "$(git rev-parse --show-toplevel)"
if git diff --cached --quiet; then
    exit 0
fi
if command -v mise >/dev/null 2>&1; then
    echo "pre-commit: mise run lint"
    exec mise run lint
fi
echo "pre-commit: cargo fmt --check && cargo clippy (mise not found)"
cargo fmt --all --check
cargo clippy --all-targets --all-features
